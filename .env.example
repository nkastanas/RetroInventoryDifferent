# Production Environment Configuration
# Copy this file to .env and configure for your deployment

# Set the language for the web front end (en, de, fr, es)
LANGUAGE=en

# Optional: override the currency independently of language (ISO 4217 code)
# If not set, currency defaults to the language's native currency (USD for en/es, EUR for de/fr)
# Example: LANGUAGE=en CURRENCY=EUR displays English UI with euro formatting (€15.50)
# CURRENCY=USD

# Domain Configuration
# Leave blank for direct-IP/local-network deployments. Set only when using
# stable HTTPS domain names through a separately managed reverse proxy.
DOMAIN=
SHOP_DOMAIN=
SHOWCASE_DOMAIN=

# Database Configuration
POSTGRES_USER=inventory
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=inventory

# Authentication
# Set a username for admin access (optional - if set, username will be required for login)
AUTH_USERNAME=admin
# Set a secure password for admin access
AUTH_PASSWORD=your_secure_admin_password_here
# JWT secret for token signing (auto-generated if not set, but recommended to set for persistence across restarts)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# AI Image Generation (optional)
# Set on the API container at runtime — never baked into the Docker image
OPENAI_API_KEY=

# Claude Sonnet Collection Assistant (optional)
ANTHROPIC_API_KEY=

# Remote device-template catalog (true or false)
EXTERNAL_TEMPLATES_ENABLED=true

# Storefront Configuration
# Contact email displayed on the shop pages (runtime env var)
CONTACT_EMAIL=store@example.com

# Umami Analytics
# If you run a umami server, set these values after creating sites in the Umami dashboard
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_STOREFRONT_WEBSITE_ID=
UMAMI_SHOWCASE_WEBSITE_ID=

# Storage Path (absolute path on host)
UPLOADS_PATH=/path/to/inventory/uploads

# Port Configuration (optional — defaults shown)
# Override these if the default ports conflict with other services on your host.
# API_PORT=4000
# WEB_PORT=3000
# STOREFRONT_PORT=3001
# SHOWCASE_PORT=3003
